{
  "dashboard": {
    "title": "Basset Hound - Monitoring",
    "description": "Monitoring dashboard for Basset Hound OSINT platform",
    "tags": ["basset-hound", "api", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (requests/sec)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(basset_request_count[1m])",
            "legendFormat": "{{method}} {{path}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(basset_request_count{status=~\"5..\"}[1m])",
            "legendFormat": "{{method}} {{path}} ({{status}})"
          }
        ]
      },
      {
        "id": 3,
        "title": "Request Latency (p50, p95, p99)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(basset_request_latency_seconds_bucket[1m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(basset_request_latency_seconds_bucket[1m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(basset_request_latency_seconds_bucket[1m]))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 4,
        "title": "Entity Count by Project",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "basset_entity_count",
            "legendFormat": "{{project}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Neo4j Query Latency",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(basset_neo4j_query_latency_seconds_bucket[1m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(basset_neo4j_query_latency_seconds_bucket[1m]))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 6,
        "title": "Request Count by Status",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "sum(rate(basset_request_count[1m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Top Slowest Endpoints",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, rate(basset_request_latency_seconds_bucket[5m])) > 0)",
            "legendFormat": "{{method}} {{path}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "Cache Hit Rate by Level",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 40
        },
        "targets": [
          {
            "expr": "basset_cache_hit_rate_percent",
            "legendFormat": "{{cache_level}}"
          }
        ],
        "alert": {
          "name": "Low Cache Hit Rate",
          "message": "Cache hit rate is below 20%",
          "conditions": [
            {
              "evaluator": {
                "type": "lt",
                "params": [20]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["basset_cache_hit_rate_percent", "5m", "now"]
              },
              "type": "query"
            }
          ]
        }
      },
      {
        "id": 9,
        "title": "Cache Items by Level",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 40
        },
        "targets": [
          {
            "expr": "basset_cache_items",
            "legendFormat": "{{cache_level}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "Cache Hits/Misses (L1 In-Memory)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 48
        },
        "targets": [
          {
            "expr": "rate(basset_cache_hits_total{cache_level=\"l1\"}[1m])",
            "legendFormat": "Hits/sec"
          },
          {
            "expr": "rate(basset_cache_misses_total{cache_level=\"l1\"}[1m])",
            "legendFormat": "Misses/sec"
          }
        ]
      },
      {
        "id": 11,
        "title": "Cache Hits/Misses (L2 Redis)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 48
        },
        "targets": [
          {
            "expr": "rate(basset_cache_hits_total{cache_level=\"l2\"}[1m])",
            "legendFormat": "Hits/sec"
          },
          {
            "expr": "rate(basset_cache_misses_total{cache_level=\"l2\"}[1m])",
            "legendFormat": "Misses/sec"
          }
        ]
      },
      {
        "id": 12,
        "title": "Cache Evictions by Reason",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 56
        },
        "targets": [
          {
            "expr": "rate(basset_cache_evictions_total[1m])",
            "legendFormat": "{{cache_level}} - {{reason}}"
          }
        ]
      },
      {
        "id": 13,
        "title": "Cache Invalidations by Type",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 56
        },
        "targets": [
          {
            "expr": "rate(basset_cache_invalidations_total[1m])",
            "legendFormat": "{{type}}"
          }
        ]
      },
      {
        "id": 14,
        "title": "Cache Size by Level",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 64
        },
        "targets": [
          {
            "expr": "basset_cache_size_bytes / 1024 / 1024",
            "legendFormat": "{{cache_level}} (MB)"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 16,
    "style": "dark",
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "uid": "basset-hound",
    "version": 1
  },
  "overwrite": true
}
