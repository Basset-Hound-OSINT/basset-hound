# Basset Hound Development Environment Configuration
# Copy this to .env and modify as needed for your environment

# =============================================================================
# Neo4j Database
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# Neo4j Connection Pool Tuning (Phase 8: Connection Pool Optimization)
# Optimized for supporting 1000+ concurrent connections with <1% timeout rate
NEO4J_POOL_SIZE=50
NEO4J_CONNECTION_LIFETIME=3600
NEO4J_MAX_RETRY_TIME=60
NEO4J_CONNECTION_TIMEOUT=30

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=false
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Authentication (disabled for development)
# =============================================================================
# Set to "true" to enable authentication in production
AUTH_ENABLED=false

# JWT secret key (change in production!)
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# Data Configuration
# =============================================================================
# Use enhanced config with 70+ social networks
DATA_CONFIG_PATH=data_config.yaml

# =============================================================================
# File Storage
# =============================================================================
PROJECTS_DIRECTORY=projects
MAX_UPLOAD_SIZE_MB=100

# =============================================================================
# CORS Settings (restrict in production)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# =============================================================================
# Basset Verify Integration (Phase 4.1)
# =============================================================================
# URL for basset-verify microservice
BASSET_VERIFY_URL=http://localhost:8001

# Request timeout in seconds
BASSET_VERIFY_TIMEOUT=10.0

# Enable/disable basset-verify integration
BASSET_VERIFY_ENABLED=true

# =============================================================================
# Basset Hound Browser Integration (Stream 8)
# =============================================================================
# WebSocket URL for basset-hound-browser Electron app
BASSET_BROWSER_WS_URL=ws://localhost:8765

# Optional authentication token for browser WebSocket
# BASSET_BROWSER_WS_TOKEN=your-token-here

# =============================================================================
# Cletus Integration (Stream 9)
# =============================================================================
# URL for cletus news aggregation service
CLETUS_BASE_URL=http://localhost:9000

# =============================================================================
# Redis Cache (for Celery and caching)
# =============================================================================
REDIS_URL=redis://localhost:6379

# Redis Connection Pool Tuning (Phase 8: Connection Pool Optimization)
# Optimized for supporting 1000+ concurrent connections with <1% timeout rate
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_KEEPALIVE=true
REDIS_HEALTH_CHECK_INTERVAL=30

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
